# =============================================================================
# SYNDEO - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values
# =============================================================================

# --- 1. Neo4j Graph Database (AuraDB or Local) ---
# Format for AuraDB: neo4j+s://<instance-id>.databases.neo4j.io
# Format for Local:  bolt://localhost:7687 or neo4j://localhost:7687
NEO4J_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_USERNAME=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your_instance_id
AURA_INSTANCENAME=Free instance

# --- 2. Sarvam AI (Multi-Agent Reasoning & Multilingual Voice) ---
# Obtain from https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key

# --- 3. Supabase (Identity Vault & Documents) ---
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
VITE_USE_SUPABASE_DOCUMENTS=false

# --- 4. Frontend API Endpoint ---
# In local dev: Keep commented out (Vite dev server proxies /api to localhost:8000)
# In production (e.g. Vercel): Set to your deployed backend URL:
# VITE_API_URL=https://syndeo-backend-wks3.onrender.com

# --- 5. Port ---
PORT=8000