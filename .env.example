# =============================================================================
# SYNDEO Environment Configuration Template
# Copy this to .env and fill in your secrets
# =============================================================================

# --- Neo4j Graph Database (AuraDB or Local) ---
NEO4J_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# --- Sarvam AI (Conversations, STT, TTS, Translation) ---
SARVAM_API_KEY=your_sarvam_api_key

# --- Supabase Identity & Document Vault ---
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
VITE_USE_SUPABASE_DOCUMENTS=false

# --- Frontend API URL (for production builds) ---
# VITE_API_URL=https://syndeo-backend.onrender.com
PORT=8000